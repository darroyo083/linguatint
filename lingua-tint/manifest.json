{
  "manifest_version": 3,
  "name": "LinguaTint",
  "version": "1.0.0",
  "description": "Colorizes German and Spanish text in bilingual content. Ideal for language learners in NotebookLM.",
  "permissions": ["storage"],
  "content_scripts": [{
    "matches": ["<all_urls>"],
    "js": ["content/defaults.js", "content/dictionaries.js", "content/language-detector.js", "data/translations-de-es.js", "content/translation.js", "content/pronunciation.js", "content/content.js"],
    "run_at": "document_idle"
  }],
  "action": {
    "default_popup": "popup/popup.html",
    "default_title": "LinguaTint"
  },
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  }
}
